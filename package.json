{
  "name": "shiti-kaoyan",
  "version": "1.6.2",
  "description": "拾题 · 错题本（本地优先，局域网多端同步）",
  "main": "main.js",
  "author": "chouyangceng",
  "license": "MIT",
  "scripts": {
    "test": "node tests/taxonomy-utils.test.js && node tests/title-code-utils.test.js && node tests/exam-utils.test.js && node tests/exam-pdf.test.js && node tests/crop-utils.test.js && node tests/sync-server.test.js",
    "start": "electron .",
    "dist": "electron-builder --win portable --mac dmg --linux",
    "dist:win": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.shiti.kaoyan",
    "productName": "拾题错题本",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "exam-utils.js",
      "taxonomy-utils.js",
      "exam-pdf.js",
      "mobile-server.js",
      "discovery-server.js",
      "preload.js",
      "app.js",
      "desktop-cropper.js",
      "index.html",
      "styles.css",
      "styles-extra.css",
      "desktop-cropper.css",
      "sw.js",
      "manifest.webmanifest",
      "icon.svg",
      "mobile/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education"
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}
